{
  "name": "ytrankwar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run d1:migrate:local && next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run d1:migrate:local && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run d1:migrate:remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx db/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "check:youtube-key": "tsx scripts/check-youtube-key.ts",
    "db:refresh-stats": "tsx scripts/refresh-channel-stats.ts",
    "d1:migrate:local": "wrangler d1 migrations apply ytrankwar-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ytrankwar-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev:fast": "next dev",
    "d1:reset:local": "node -e \"require('fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && npm run d1:migrate:local"
  },
  "dependencies": {
    "nanoid": "5.0.7",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@opennextjs/cloudflare": "1.10.0",
    "@types/node": "^22.20.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "tsx": "4.16.2",
    "typescript": "5.5.4",
    "wrangler": "^4.141.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}