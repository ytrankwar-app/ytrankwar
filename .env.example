# Local SQLite file path (dev/demo only). In Cloudflare production this is
# replaced entirely by a D1 binding in wrangler.toml — this variable is unused
# there.
SQLITE_PATH=./data/app.db

# Absolute base URL of the deployment, used to build absolute links in
# /robots.txt and /sitemap.xml (see app/robots.ts, app/sitemap.ts). Set this
# to the real production domain before deploying.
SITE_URL=https://ytrankwar.example

# --- Real integrations ---

# YouTube Data API v3 key. Set this to fetch real channel names, logos,
# subscriber/view/video counts, and creation dates via lib/youtube.ts.
# Without it, channel data is deterministic mock data (same input always
# produces the same fake numbers) so the app still works out of the box.
#
# Get a key: console.cloud.google.com -> create/select a project ->
# enable "YouTube Data API v3" -> Credentials -> Create API key. Free tier
# is 10,000 quota units/day; a direct channel lookup costs 1 unit, but the
# custom-URL/name fallback search costs 100 (see lib/youtube.ts).
YOUTUBE_API_KEY=

# Stripe secret key (server-side) and webhook signing secret. Required to
# replace app/api/payments/create and app/api/payments/webhook with real
# Stripe Checkout Sessions + verified webhook events (currently mocked —
# see the payments flow in lib/bidding-service.ts + app/api/payments/*).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_STRIPE_KEY=

# Google OAuth client. Not used by anything in this app today (there is no
# login — see the README's "No login" section) — only relevant if optional
# real accounts are ever added on top of the manage_token model, where it
# could double as Method A of channel ownership verification.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Only relevant if the optional real-accounts layer above is ever added.
# Unused by anything in this app today.
SESSION_SECRET=

# Cloudflare deployment (see wrangler.toml)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
