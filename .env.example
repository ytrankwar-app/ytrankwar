# Local development. Copy to .env.local (Next.js) — or use .dev.vars (see
# .dev.vars.example). In production these live in wrangler.toml [vars] and
# `wrangler secret put`, NOT in a file.

# Public base URL of the site (production: your main domain, https, no
# trailing slash). If unset, the site falls back to the host of each request.
SITE_URL=http://ytrankwar.lol

# YouTube Data API v3 key. Without it, channel data is deterministic mock
# data so the app still works out of the box. Free quota: 10,000 units/day.
YOUTUBE_API_KEY=AIzaSyCvay7Jokbgqo27RwYsxdRmPUduA0x_lTs

# --- Dodo Payments (https://app.dodopayments.com) ---
# API key: Developer -> API Keys.  Webhook secret: Developer -> Webhooks
# (endpoint https://YOURDOMAIN/api/payments/webhook, event: payment.succeeded,
# payment.failed, refund.succeeded, dispute.opened, dispute.lost).
# Product: create ONE one-time "Pay What You Want" product (USD, minimum $1,
# maximum >= $10,000) and put its id here.
DODO_PAYMENTS_API_KEY=HOiso7LFVP0J87_l.L-lgQdETAIIaHu0NKyDWjnEBxIDTJoS3H5_m_AYqt88m2376
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode   # or live_mode
DODO_PRODUCT_ID=

# Local-only SQLite file used by `npm run db:seed` and scripts (not by the app).
SQLITE_PATH=./data/app.db
